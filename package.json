{
  "name": "camadb-workspace",
  "version": "0.2.0",
  "private": true,
  "description": "CamaDB monorepo",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "scripts": {
    "build": "tsc --build",
    "benchmark:storage": "yarn workspace @camadb/benchmarks benchmark",
    "clean": "tsc --build --clean",
    "typecheck": "tsc --build --pretty false && tsc --project packages/core/tsconfig.type-tests.json --pretty false",
    "lint": "eslint packages tests scripts --ext .js,.ts",
    "lint:fix": "yarn lint --fix",
    "format": "prettier --write \"{packages,apps,examples,tests,docs}/**/*.{js,ts,json,md}\"",
    "format:check": "prettier --check \"{packages,apps,examples,tests,docs}/**/*.{js,ts,json,md}\"",
    "test": "jest --config jest.config.js",
    "test:integration": "jest --config jest.config.js tests/integration --runInBand",
    "check:boundaries": "node scripts/check-boundaries.js",
    "check:packages": "node scripts/check-packages.js",
    "test:packages": "node scripts/test-package-consumers.js",
    "validate": "yarn typecheck && yarn lint && yarn test --runInBand && yarn check:boundaries && yarn check:packages && yarn build",
    "release:check": "yarn validate && yarn test:packages && node scripts/publish-workspaces.js --dry-run",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "version:alpha": "changeset version --snapshot alpha",
    "release:alpha": "changeset publish --tag alpha --no-git-tag"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.0",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "esbuild": "0.28.2",
    "eslint": "^8.57.1",
    "eslint-plugin-jest": "^28.14.0",
    "fake-indexeddb": "^6.2.2",
    "jest": "^29.7.0",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.1",
    "typedoc": "^0.28.12",
    "typescript": "^5.9.2"
  }
}
