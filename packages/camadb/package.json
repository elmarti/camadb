{
  "name": "camadb",
  "version": "3.0.0-rc.0",
  "description": "Compatibility package for CamaDB",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build --pretty false",
    "test": "jest --config ../../jest.config.js packages/camadb/src --runInBand"
  },
  "dependencies": {
    "@camadb/core": "3.0.0-rc.0"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
