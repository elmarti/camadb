{
  "name": "@camadb/benchmarks",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "benchmark": "yarn build && node --expose-gc dist/run.js",
    "benchmark:cache": "yarn build && node --expose-gc dist/cache-run.js",
    "benchmark:index": "yarn build && node --expose-gc dist/index-run.js",
    "benchmark:text": "yarn build && node --expose-gc dist/text-search-run.js",
    "benchmark:vector": "yarn build && node --expose-gc dist/vector-search-run.js",
    "benchmark:hybrid": "yarn build && node --expose-gc dist/hybrid-search-run.js",
    "benchmark:memory": "yarn build && node --expose-gc dist/memory-run.js",
    "benchmark:compare": "yarn build && node dist/compare.js",
    "benchmark:ci": "yarn build && node dist/ci-run.js",
    "build": "tsc --build",
    "typecheck": "tsc --build --pretty false"
  },
  "dependencies": {
    "@camadb/core": "3.0.0-rc.0",
    "@camadb/memory": "0.2.0-rc.0",
    "@camadb/test-utils": "0.1.0",
    "fake-indexeddb": "^6.2.2"
  }
}
